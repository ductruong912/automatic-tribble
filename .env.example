# RAG Chatbot Environment Configuration
# Copy this file to .env and update the values as needed

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8500
DEBUG=False
RELOAD=False
UVICORN_WORKERS=1

# =============================================================================
# LLM CONFIGURATION (CLOUD API OR LOCAL LLAMA.CPP)
# =============================================================================
# --- Option 1: OpenAI Cloud API ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Option 2: Local llama.cpp / LM Studio / Ollama ---
# For local llama-server (run scripts/run_local_llm.bat):
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_API_KEY=llama.cpp
# OPENAI_MODEL=qwen3-8b
# For Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b

OPENAI_MAX_TOKENS=5000
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60

# =============================================================================
# PERFORMANCE OPTIMIZATION SETTINGS
# =============================================================================
LLM_CACHE_TTL=300
LLM_CACHE_MAX_SIZE=100
LLM_CACHE_MAX_ENTRIES=50
MAX_CONTEXT_LENGTH=12000
LLM_HISTORY_LENGTH=9
# Cap on each client-supplied history message, in characters
MAX_HISTORY_MESSAGE_LENGTH=4000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=ERROR
LOG_TO_FILE=False
LOG_DIR=data/logs
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=True

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.txt,.pdf,.docx,.csv,.xlsx
MAX_FILES_PER_BATCH=10
MAX_TOTAL_BATCH_SIZE=209715200

# =============================================================================
# OCR CONFIGURATION
# =============================================================================
# Engine for scanned pages: easyocr (accurate, slow) | rapidocr (fast, better on tables)
OCR_ENGINE=easyocr
OCR_LANGUAGES=vi
# PP-OCRv6 tier for rapidocr: tiny | small | medium
OCR_RAPIDOCR_MODEL_SIZE=small
# EasyOCR detection sensitivity; lower finds fainter words
OCR_EASYOCR_LOW_TEXT=0.35
# auto | false
OCR_GPU=auto
OCR_DPI=300
OCR_AUTO_ROTATE=true
# none | light (deskew) | standard (deskew+denoise) | full
OCR_PREPROCESS_PROFILE=light
# Below this many characters, a page with an image is treated as a scan
PDF_TEXT_MIN_CHARS_PER_PAGE=100
# Re-read a text layer with fewer accented letters than this (Vietnamese only)
PDF_TEXT_MIN_DIACRITIC_RATIO=0.03
OCR_MAX_CONCURRENT_FILES=1

# =============================================================================
# DATA STRUCTURE PATHS
# =============================================================================
CHUNKS_DIR=data/chunks
VECTORS_DIR=data/vectors
TEMP_DIR=data/temp
VECTOR_STORE_PATH=data/vectors/vector_store.pkl

# =============================================================================
# RAG CONFIGURATION
# =============================================================================
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Reorders results only; the top retrieval hits are pinned (see _merge_reranked)
RERANKING_ENABLED=True
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Candidate pool and input length follow the device (GPU: 32/512, CPU: 12/256).
# Uncomment to override.
# RERANKER_CANDIDATES=12
# RERANKER_MAX_LENGTH=256
# Best reranker score below this -> empty context -> prompt fallback. Leave empty to disable.
RERANK_MIN_SCORE=-3.0
# Query adapter path (.npy format)
QUERY_ADAPTER_PATH=data/query_adapter.npy


# =============================================================================
# HUGGING FACE / MODEL CACHE CONFIGURATION
# =============================================================================
# On Windows without Developer Mode / Admin rights, creating symlinks in HF cache
# causes [WinError 1314]. Setting HF_HUB_DISABLE_SYMLINKS=1 forces HF to copy files.
HF_HUB_DISABLE_SYMLINKS=1
# Suppress the degraded cache warning emitted by huggingface_hub on Windows
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# =============================================================================
# CHAT & RETRIEVAL CONFIGURATION
# =============================================================================
RETRIEVAL_TOP_K=8
CHUNK_SIZE=1000
CHUNK_OVERLAP=0
SEMANTIC_WEIGHT=0.3
SIMILARITY_THRESHOLD=0.4

# =============================================================================
# CONTEXT EXPANSION
# =============================================================================
CONTEXT_EXPANSION_ENABLED=True
CONTEXT_EXPANSION_RADIUS=1
MAX_CONTEXT_CHUNKS=5

# =============================================================================
# VECTOR STORE AND EMBEDDINGS
# =============================================================================
# Flat FAISS index gains nothing below ~20k chunks; turn on when the store grows
USE_FAISS_INDEX=False

# =============================================================================
# VIETNAMESE PREPROCESSING CONFIGURATION
# =============================================================================
VIETNAMESE_PREPROCESSING_ENABLED=True
CLEAN_SPECIAL_CHARS=True
EXTRACT_CONTENT_WORDS=True

# =============================================================================
# CONFIDENCE SCORING CONFIGURATION
# =============================================================================
CONFIDENCE_SCORING_ENABLED=True
CONFIDENCE_CONTEXT_WEIGHT=0.35
CONFIDENCE_LENGTH_WEIGHT=0.20
CONFIDENCE_COHERENCE_WEIGHT=0.25
CONFIDENCE_CITATION_WEIGHT=0.10
CONFIDENCE_UNCERTAINTY_WEIGHT=0.10

# =============================================================================
# GPU CONFIGURATION
# =============================================================================
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all

# =============================================================================
# SERVICE HEALTH MONITORING
# =============================================================================
SERVICE_SUCCESS_RATE_THRESHOLD=80.0
SERVICE_MIN_REQUESTS_FOR_HEALTH=10

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_START_PERIOD=5
HEALTH_CHECK_RETRIES=3

# =============================================================================
# SERVER, CORS & RATE LIMITING CONFIGURATION
# =============================================================================
# Allowed origins (comma-separated, e.g. http://localhost:8501,http://localhost:3000 or * for public APIs without credentials)
CORS_ORIGINS=*
# Must be False if CORS_ORIGINS is *; set to True only with specific origin domains
CORS_ALLOW_CREDENTIALS=False
# Admin API key for sensitive maintenance endpoints (POST /cleanup/*)
ADMIN_API_KEY=your-secure-admin-api-key-here
ENABLE_RATE_LIMITING=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_CONCURRENT=50

# =============================================================================
# STREAMLIT FRONTEND (app.py)
# =============================================================================
# Bot name, used for both the browser tab and the chat header
APP_TITLE=ChatBot
# Logo shown in the chat header. Optional - the header renders without it.
APP_LOGO_PATH=assets/img/logo.png
# Start the backend automatically when app.py cannot reach it
AUTO_START_API=true
